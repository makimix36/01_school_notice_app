<% content_for(:title, t('.title')) %>
<!-- フォーム全体を囲むコンテナ（白背景、角丸、ふわっとした影） -->
<div class="max-w-2xl mx-auto bg-white p-8 md:p-12 rounded-2xl shadow-lg my-12 border border-gray-100">
  
  <h2 class="text-2xl font-extrabold text-gray-800 mb-2 text-center">
    <%= t('.title') %>
  </h2>

  <!-- Railsの form_with を使用 (space-y-6 で各入力欄の間に均等な余白を空ける) -->
  <%= form_with model: @user, class: "space-y-6" do |f| %>
<!-- 💡 もしエラーメッセージを表示したい場合はここに書きます -->
    <div class="text-red-600">
      <%= render 'shared/error_messages', object: f.object %>
    </div>

    <!-- ▼ お名前入力欄 ▼ -->
    <div>
      <%= f.label :nickname, "ニックネーム（アプリ内での表示に使います）", class: "block text-sm font-bold text-gray-700 mb-2" %>
      <%= f.text_field :nickname,
            class: "w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none transition duration-200 bg-gray-50 focus:bg-white", 
            placeholder: "山田 太郎" %>
    </div>

    <!-- ▼ メールアドレス入力欄 ▼ -->
    <div>
      <%= f.label :email, "メールアドレス（必須）", class: "block text-sm font-bold text-gray-700 mb-2" %>
      <%= f.email_field :email, 
            class: "w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none transition duration-200 bg-gray-50 focus:bg-white", 
            placeholder: "example@reserva.com" %>
    </div>

    <!-- ▼ パスワード入力欄 ▼ -->
    <div>
      <%= f.label :password, "パスワード（必須）", class: "block text-sm font-bold text-gray-700 mb-2" %>
      <label class="block text-sm text-gray-700 mb-2">6文字以上で入力してください</label>
      <%= f.password_field :password, 
            class: "w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none transition duration-200 bg-gray-50 focus:bg-white" %>
    </div>
<!-- ▼ 確認用パスワード入力欄 ▼ -->
    <div>
      <%= f.label :password_confirmation, "パスワード確認（必須）", class: "block text-sm font-bold text-gray-700 mb-2" %>
      <%= f.password_field :password_confirmation, 
            class: "w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none transition duration-200 bg-gray-50 focus:bg-white" %>
    </div>


    <!-- ▼ 送信ボタン ▼ -->
    <div class="pt-4">
      <%= f.submit "送信する", 
            class: "w-full bg-emerald-500 hover:bg-emerald-600 text-white font-bold py-4 px-8 rounded-full shadow-md hover:shadow-lg transition-all duration-300 cursor-pointer text-lg" %>
    </div>

  <% end %>
</div>