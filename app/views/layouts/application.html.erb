<!DOCTYPE html>
<html>
  <head>
    <title>MyApp</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- ▼ ここがRails 7 + Tailwindで最も重要な読み込み部分です ▼ -->
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    

  </head>

  <!-- ▼ ここから下はスマホ対応＆フッター下部固定の基本レイアウト ▼ -->
  <body class="bg-gray-50 text-gray-800 flex flex-col min-h-screen font-sans antialiased">
    
    <!-- 1. ヘッダー -->
    <header class="bg-white shadow-sm sticky top-0 z-50">
      <div class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between">
        <%= link_to "マイアプリ", root_path, class: "text-xl font-bold text-blue-600" %>
        <nav>
          <!-- 将来的にログインボタンなどをここに配置します -->
        </nav>
      </div>
    </header>

    <!-- 2. メインコンテンツ領域 -->
    <main class="flex-grow w-full max-w-6xl mx-auto px-4 py-8 sm:px-6 lg:px-8">
      
      <!-- 成功やエラーの通知メッセージ（Devise導入時にも役立ちます） -->
      <% if notice.present? %>
        <p class="bg-blue-100 text-blue-700 px-4 py-3 rounded-lg mb-6 shadow-sm"><%= notice %></p>
      <% end %>
      <% if alert.present? %>
        <p class="bg-red-100 text-red-700 px-4 py-3 rounded-lg mb-6 shadow-sm"><%= alert %></p>
      <% end %>

      <!-- 各ページの中身がここに展開されます -->
      <%= yield %>
      
    </main>

    <!-- 3. フッター -->
    <footer class="bg-gray-800 text-gray-400 py-6 text-center text-sm">
      <div class="max-w-6xl mx-auto px-4">
        &copy; <%= Date.today.year %> MyApp. All rights reserved.
      </div>
    </footer>

  </body>
</html>