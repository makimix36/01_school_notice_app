<header class="bg-white shadow-sm sticky top-0 z-50">
  <div class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between">
    
    <!-- ▼ 左側：アプリのタイトル ▼ -->
    <%= link_to "学校お知らせ整理アプリ", notifications_path, class: "text-xl font-bold text-blue-600 hover:text-blue-700 transition" %>

    <!-- ▼ 右側：ユーザー情報とボタンのエリア ▼ -->
    <!-- flex-col（縦並び）と items-end（右寄せ）を組み合わせます -->
    <div class="flex flex-col items-end">
      
      <!-- 上段：ユーザー名 -->
      <div class="text-sm font-medium text-gray-600 mb-2">
        こんにちは、<%= current_user.nickname %>さん
      </div>
      
      <!-- 下段：アクションボタン（横並び） -->
      <!-- flex（横並び）と gap-3（ボタン間の余白）を設定 -->
      <div class="flex items-center gap-3">
        
        <!-- お知らせ作成ボタン（目立たせるメインカラー） -->
        <%= link_to t('header.create_notification'), new_notification_path, 
              class: "bg-emerald-500 hover:bg-emerald-600 text-white text-sm font-bold py-2 px-4 rounded-full shadow-sm transition duration-200" %>
        
        <!-- ログアウトボタン（控えめなサブカラー） -->
        <%= link_to t('header.logout'), logout_path, data: { turbo_method: :delete }, 
              class: "bg-white hover:bg-gray-50 text-gray-700 text-sm font-bold py-2 px-4 rounded-full border border-gray-300 shadow-sm transition duration-200" %>
              
      </div>
    </div>

  </div>
</header>