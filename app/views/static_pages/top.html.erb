<!-- 
  flex-col: スマホでは縦積み
  md:flex-row: PC（mdサイズ以上）では横並び
  items-center: 縦の中央揃え
-->
<div class="flex flex-col md:flex-row items-center justify-between py-12 md:py-24 px-4 sm:px-6">
  
  <!-- ▼ 左側：テキストとボタンのエリア ▼ -->
  <!-- 
    w-full: スマホでは幅100%
    md:w-1/2: PCでは幅50%（半分）
    text-center md:text-left: スマホは中央揃え、PCは左揃え
  -->
  <div class="w-full md:w-1/2 text-center md:text-left flex flex-col items-center md:items-start">
    
    <h1 class="text-4xl md:text-5xl font-extrabold text-gray-800 leading-tight tracking-tight mb-6">
      学校からのお知らせを<br>
      紙もメールもまとめて<br>
      サクッと整理！
    </h1>
    
    <p class="text-lg md:text-xl text-gray-600 mb-10">
      写真やテキストを貼り付けて、子どもや締切も管理
    </p>

    <!-- ボタンエリア（スマホでもPCでも縦積み。横幅をボタンっぽく制限） -->
    <div class="w-full max-w-sm flex flex-col gap-4">
      <a href="#" class="block w-full text-center bg-emerald-500 hover:bg-emerald-600 text-white font-bold py-4 px-8 rounded-full shadow-md transition duration-300">
        メールで新規登録
      </a>
      <a href="#" class="block w-full text-center bg-white hover:bg-gray-50 text-gray-800 font-bold py-4 px-8 rounded-full border-2 border-gray-800 transition duration-300">
        ログイン
      </a>
    </div>
  </div>

  <!-- ▼ 右側：画像のエリア ▼ -->
  <!-- mt-12 md:mt-0: スマホの時はテキストとの間に余白(mt-12)、PCの時は余白なし(md:mt-0) -->
  <div class="w-full md:w-1/2 mt-12 md:mt-0 flex justify-center md:justify-end">

    <div class="w-full max-w-lg aspect-video rounded-lg flex items-center justify-center text-gray-400">
      <%= image_tag "hero-image.png", alt: "学校お知らせ整理アプリ画像", class: "w-full max-w-lg object-contain drop-shadow-xl bg-transparent" %>
    </div>
  </div>
  
</div>