<% content_for(:title, t('.title')) %>
<div class="fixed top-28 right-4 z-50 space-y-2">
  <% flash.each do |message_type, message| %>
    <div data-controller="flash" class="<%= flash_class(message_type) %> p-4 rounded shadow-lg">
      <%= message %>
    </div>
  <% end %>
</div>
<div class="max-w-7xl mx-auto px-4 sm:px-6 my-12">
  <h1 class="text-2xl font-extrabold text-gray-800 mb-8 text-center md:text-left"><%= t('.title') %></h1>

<!-- ▼ グリッドレイアウト（スマホ:1列, タブレット:2列, PC:3列） ▼ -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <% if @notifications.present? %>
          <%= render @notifications %>
        <% else %>
          <div class="mb-3">お知らせがありません</div>
        <% end %>

  </div>
 </div>