<!-- ==========================================
         ▼ カード（画像はみ出し修正版） ▼
    =========================================== -->
    <div class="bg-white rounded-2xl shadow-md hover:shadow-xl transition-shadow duration-300 overflow-hidden flex flex-col border border-gray-100">
      
      <!-- 1. 画像エリア -->
      <!-- overflow-hidden を追加し、枠からはみ出た部分を強制的に隠す -->
      <div class="relative h-48 bg-gray-100 flex-shrink-0 overflow-hidden">
        <% if notification.image.present? %>
          <%= image_tag notification.image, class: "w-full h-full object-cover" %>
        <% else %>
          <!-- 画像がない場合のダミー -->
          <%= image_tag "default.png" %>
        <% end %>        


        <!-- 「重要」バッジ -->
        <% if notification.is_important? %>
          <div class="absolute top-3 right-3 bg-red-500 text-white text-xs font-bold px-3 py-1 rounded-full shadow-sm">
            重要
          </div>
        <% end %>
      </div>

      <!-- 2. コンテンツエリア -->
      <div class="p-6 flex-1 flex flex-col">
        <!-- 各種タグ -->
        <div class="flex flex-wrap gap-2 mb-3">
          <% if notification.period_type != "unspecified" %>
            <span class="bg-emerald-50 text-emerald-600 text-xs font-bold px-2.5 py-1 rounded-md border border-emerald-100"><%= notification.period_type_i18n %></span>
          <% end %>
          <% if notification.is_submission? %>
            <span class="bg-blue-50 text-blue-600 text-xs font-bold px-2.5 py-1 rounded-md border border-blue-100">提出あり</span>
          <% end %>
          <% if notification.is_document? %>
            <span class="bg-purple-50 text-purple-600 text-xs font-bold px-2.5 py-1 rounded-md border border-purple-100">書類あり</span>
          <% end %>
        </div>


        <!-- タイトルと内容 -->
        <h3 class="text-xl font-bold text-gray-800 mb-2 line-clamp-2">
          <%= notification.title %>
        </h3>
        <p class="text-gray-600 text-sm mb-4 line-clamp-3">
         <%= notification.body %>
        </p>

        <!-- 期限 -->
        <div class="text-sm font-medium text-gray-500 mt-auto mb-4 flex items-center">
          <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
          期限: <%= notification.deadline %>
        </div>

        <!-- 3. アクションボタン -->
        <div class="flex items-center justify-between mt-2 pt-4 border-t border-gray-100">
          <%= link_to "詳細を見る", "#", class: "text-emerald-500 hover:text-emerald-600 font-bold text-sm flex items-center transition duration-200" %>
          <%= button_to "削除", "#", method: :delete, form: { data: { turbo_confirm: "本当に削除しますか？" } }, class: "text-gray-400 hover:text-red-500 text-sm font-bold transition duration-200" %>
        </div>
      </div>
    </div>