<!-- ==========================================
         ▼ カード（画像はみ出し修正版） ▼
    =========================================== -->
<div class="bg-white rounded-2xl shadow-sm hover:shadow-lg transition-shadow duration-300 flex flex-col border border-gray-200 p-6">
      
      <!-- 1. 上部メタ情報（重要バッジ ＆ 期限） -->
        <div class="flex items-center justify-start gap-3 mb-3">
        <% if notification.is_important? %>
        <div class="bg-red-500 text-white text-xs font-bold px-2.5 py-1 rounded-full shadow-sm">
          重要
        </div>
        <% end %>
        <div class="flex items-center text-gray-500 text-xs font-medium">
          <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
          <% if notification.deadline? %>
           期限:<%= notification.deadline %>
          <% else %>
          期限なし
          <% end %>
        </div>
      </div>

      <!-- 2. タイトル -->
      <h3 class="text-lg font-bold text-gray-800 mb-2 line-clamp-2">
        <%= notification.title %>
      </h3>

      <!-- 3. 各種タグ -->
        <div class="flex flex-wrap gap-2 mb-3">
          <% if notification.period_type != "unspecified" %>
            <span class="bg-emerald-50 text-emerald-600 text-xs font-bold px-2.5 py-1 rounded-md border border-emerald-100"><%= notification.period_type_i18n %></span>
          <% end %>
          <% if notification.is_submission? %>
            <span class="bg-blue-50 text-blue-600 text-xs font-bold px-2.5 py-1 rounded-md border border-blue-100">提出あり</span>
          <% end %>
          <% if notification.is_document? %>
            <span class="bg-purple-50 text-purple-600 text-xs font-bold px-2.5 py-1 rounded-md border border-purple-100">書類あり</span>
          <% end %>
        </div>

      <!-- 4. 本文 -->
      <p class="text-gray-600 text-sm mb-4 line-clamp-2">
        <%= notification.body %>
      </p>

      <!-- 💡 mt-auto で以下の要素をカードの最下部に押し下げて高さを揃えます -->
      <div class="mt-auto">
        <!-- 5. 添付ファイル（コンパクト版） -->
        <% if notification.file.attached? %>
        <div class="mb-4 p-3 border border-gray-200 rounded-lg bg-gray-50 flex items-center justify-between">
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
            <span class="text-sm font-bold text-gray-700">プリント</span>
          </div>
          <%= link_to "拡大", url_for(notification.file), target: "_blank", rel: "noopener", class: "text-xs font-bold text-emerald-600 bg-white border border-gray-300 px-3 py-1.5 rounded shadow-sm hover:bg-gray-50 transition" %>
        </div>
        <% end %>
        
        <!-- 6. アクションボタン -->
        <div class="flex items-center justify-between pt-4 border-t border-gray-100">
          <%= link_to "詳細を見る", notification_path(notification), class: "text-emerald-500 hover:text-emerald-600 font-bold text-sm flex items-center transition duration-200" %>
          <%= button_to "削除", "#", method: :delete, form: { data: { turbo_confirm: "本当に削除しますか？" } }, class: "text-gray-400 hover:text-red-500 text-sm font-bold transition duration-200" %>
        </div>
      </div>
    </div>