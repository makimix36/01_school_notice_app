<% content_for(:title, t('.title')) %>
<div class="fixed top-18 right-4 z-50 space-y-2">
  <% flash.each do |message_type, message| %>
    <div data-controller="flash" class="<%= flash_class(message_type) %> p-4 rounded shadow-lg">
      <%= message %>
    </div>
  <% end %>
</div>
<!-- フォーム全体を囲むコンテナ（白背景、角丸、ふわっとした影） -->
<div class="max-w-2xl mx-auto bg-white p-8 md:p-12 rounded-2xl shadow-lg my-12 border border-gray-100">

  <h2 class="text-2xl font-extrabold text-gray-800 mb-2 text-center">
    <%= t('.title') %>
  </h2>
  <p class="text-gray-500 text-center mb-8 text-sm">
    ご不明な点がございましたら、お気軽にご連絡ください。
  </p>

  <!-- Railsの form_with を使用 (space-y-6 で各入力欄の間に均等な余白を空ける) -->
  <%= form_with url: login_path, class: "space-y-6" do |f| %>
<!-- 💡 もしエラーメッセージを表示したい場合はここに書きます -->


    <!-- ▼ メールアドレス入力欄 ▼ -->
    <div>
      <%= f.label :email, "メールアドレス", class: "block text-sm font-bold text-gray-700 mb-2" %>
      <%= f.email_field :email, 
            class: "w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none transition duration-200 bg-gray-50 focus:bg-white", 
            placeholder: "example@reserva.com" %>
    </div>

    <!-- ▼ パスワード入力欄 ▼ -->
    <div>
      <%= f.label :password, "パスワード", class: "block text-sm font-bold text-gray-700 mb-2" %>
      <%= f.password_field :password, 
            class: "w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none transition duration-200 bg-gray-50 focus:bg-white" %>
    </div>

    <!-- ▼ 送信ボタン ▼ -->
    <div class="pt-4">
      <%= f.submit "ログイン", 
            class: "w-full bg-emerald-500 hover:bg-emerald-600 text-white font-bold py-4 px-8 rounded-full shadow-md hover:shadow-lg transition-all duration-300 cursor-pointer text-lg" %>
    </div>
      <div class='text-center'>
        <%= link_to t('.to_register_page'), new_user_path %>
      </div>
  <% end %>
  

</div>
